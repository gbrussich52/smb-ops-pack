{
  "mcpServers": {
    "smb-ops-pipeline": {
      "command": "node",
      "args": ["${CURSOR_PLUGIN_ROOT}/src/server.mjs"],
      "env": {
        "PIPELINE_BACKEND": "${PIPELINE_BACKEND}",
